@model IEnumerable<WebApplication1.Models.Project>
@Html.AntiForgeryToken()
@section Styles {
<style>
.sort-field-btn { padding: 2px 10px; border-radius: 6px; border: 1.5px solid #dee2e6; background: #fff; font-size: .78rem; cursor: pointer; transition: all .15s; white-space: nowrap; line-height: 1.9; }
.sort-field-btn:hover { border-color: #6c757d; background: #f8f9fa; }
.sort-field-btn.sort-active { background: #374151; color: #fff; border-color: #374151; }
.sort-arrow { font-size: .9em; }
</style>
}
@{
    ViewData["Title"] = "Archive";
    var userRole = Context.Session.GetString("UserRole") ?? "User";
    var searchTerm = ViewBag.SearchTerm ?? "";
    var canEdit = userRole == "Admin" || userRole == "Editor";

    string Initials(WebApplication1.Models.User? u) {
        if (u == null) return "?";
        var f = u.FirstName?.Length > 0 ? u.FirstName[0].ToString() : "";
        var l = u.LastName?.Length > 0 ? u.LastName[0].ToString() : "";
        return f + l;
    }

    string PriorityCls(string? p) => p switch {
        "High" => "priority-high", "Medium" => "priority-medium", "Low" => "priority-low", _ => "priority-none"
    };

    // Build distinct month list from UpdatedAt (closed date)
    var months = Model
        .Select(p => (p.UpdatedAt ?? p.CreatedAt))
        .Where(d => d != default)
        .Select(d => new { Key = d.ToString("yyyy-MM"), Label = d.ToString("MMM ") + (d.Year + 543) })
        .DistinctBy(x => x.Key)
        .OrderByDescending(x => x.Key)
        .ToList();

    // Build distinct year list (Buddhist Era)
    var years = Model
        .Select(p => (p.UpdatedAt ?? p.CreatedAt).Year + 543)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();

    // Build distinct group list
    var groups = Model
        .SelectMany(p => p.Groups.Select(g => g.Group))
        .Where(g => g != null)
        .DistinctBy(g => g!.Id)
        .OrderBy(g => g!.Name)
        .ToList();
}

<div class="container-fluid">

    <div class="card mb-2">
        <div class="card-body py-2">
            <input type="text" id="archiveSearch" class="form-control" placeholder="Search by project or owner name..." />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2 px-3">
            <div id="filterRows" class="d-flex flex-column gap-2 mb-2"></div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button onclick="addFilterRow()" class="btn btn-sm btn-outline-primary" style="font-size:.8rem;">
                    <i class="fas fa-plus me-1"></i>Add Filter
                </button>
                <button onclick="clearAllFilters()" class="btn btn-sm btn-outline-secondary" style="font-size:.8rem;">
                    <i class="fas fa-times me-1"></i>Clear All
                </button>
                <span id="filterCount" class="text-muted ms-auto" style="font-size:.8rem;"></span>
            </div>
            <div class="d-flex gap-1 align-items-center flex-wrap mt-2 pt-2 border-top">
                <span class="text-muted small me-1">Sort:</span>
                <button class="sort-field-btn" data-field="name">Name <span class="sort-arrow">↕</span></button>
                <button class="sort-field-btn" data-field="priority">Priority <span class="sort-arrow">↕</span></button>
                <button class="sort-field-btn" data-field="date">Due Date <span class="sort-arrow">↕</span></button>
                <button class="sort-field-btn" data-field="progress">Progress <span class="sort-arrow">↕</span></button>
            </div>
        </div>
    </div>

    <script>
    // Data from server
    const MONTHS_DATA = [@Html.Raw(string.Join(",", months.Select(m => "{key:'" + m.Key + "',label:'" + m.Label + "'}")))] ;
    const YEARS_DATA  = [@Html.Raw(string.Join(",", years))];
    const GROUPS_DATA = [@Html.Raw(string.Join(",", groups.Select(g => "{id:'" + g!.Id + "',name:'" + g!.Name.Replace("'", "\\'") + "'}")))];
    </script>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center border-0 shadow-sm">
            <i class="fas fa-archive" style="font-size:48px;color:#ccc;"></i>
            <p class="text-muted mt-3">No archived tasks yet.</p>
        </div>
    }
    else
    {
        <div id="archiveGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.75rem;">
            @foreach (var project in Model)
            {
                <div class="kanban-card" style="cursor:pointer;"
                     data-id="@project.Id" data-name="@project.Name" data-status="@project.Status"
                     data-priority="@(project.Priority ?? "None")"
                     data-month="@((project.UpdatedAt ?? project.CreatedAt).ToString("yyyy-MM"))"
                     data-year="@((project.UpdatedAt ?? project.CreatedAt).Year + 543)"
                     data-group="@string.Join(",", project.Groups.Select(g => g.GroupId))"
                     data-search="@($"{project.Name} {string.Join(' ', project.Owners.Select(o => o.User != null ? o.User.FirstName + " " + o.User.LastName : ""))}".ToLower())"
                     data-due-date="@(project.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                     data-progress="@project.Progress"
                     onclick="openDetailModal(this.dataset.id, this.dataset.name, this.dataset.status)">
                    <span class="badge bg-secondary mb-1" style="font-size:.65rem;">Archived</span>

                    <span class="kanban-card-title d-block">@project.Name</span>

                    @if (!string.IsNullOrWhiteSpace(project.Description))
                    {
                        <p class="kanban-card-desc">@project.Description</p>
                    }

                    <div class="kanban-quick-row mt-1">
                        @if (project.Owners.Any())
                        {
                            <span class="kanban-quick-btn kanban-quick-btn-empty" style="cursor:default;">
                                <div class="kanban-avatars">
                                    @foreach (var owner in project.Owners.Take(3))
                                    {
                                        <span class="kanban-card-avatar" title="@owner.User?.FirstName @owner.User?.LastName">
                                            @Initials(owner.User)
                                        </span>
                                    }
                                    @if (project.Owners.Count() > 3)
                                    {
                                        <span class="kanban-card-avatar kanban-card-avatar-more">+@(project.Owners.Count() - 3)</span>
                                    }
                                </div>
                            </span>
                        }

                        @if (project.Groups.Any())
                        {
                            <span class="kanban-quick-btn kanban-quick-btn-group" style="cursor:default;">
                                @foreach (var ga in project.Groups.Take(2))
                                {
                                    <span style="width:8px;height:8px;border-radius:50%;background:@(ga.Group?.Color ?? "#6c757d");display:inline-block;margin-right:2px;"></span>
                                }
                                <span>@string.Join(", ", project.Groups.Take(2).Select(ga => ga.Group?.Name ?? ""))</span>
                            </span>
                        }

                        @if (project.EndDate.HasValue)
                        {
                            <span class="kanban-quick-btn kanban-quick-btn-empty" style="cursor:default;"
                                  title="@project.EndDate.Value.ToString("dd MMM ") @(project.EndDate.Value.Year + 543)">
                                <i class="fas fa-calendar-alt me-1"></i>
                                @project.EndDate.Value.ToString("dd MMM ") @(project.EndDate.Value.Year + 543)
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(project.Priority) && project.Priority != "None")
                        {
                            <span class="kanban-quick-btn kanban-priority-btn @PriorityCls(project.Priority)" style="cursor:default;">
                                <i class="fas fa-flag me-1"></i>@project.Priority
                            </span>
                        }
                    </div>

                    @if (canEdit)
                    {
                        <div class="mt-2 d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary reopen-btn"
                                    data-project-id="@project.Id" title="Reopen task"
                                    onclick="event.stopPropagation()">
                                <i class="fas fa-undo me-1"></i>Reopen
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="taskDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2 px-3">
                <input type="text" id="taskDetailTitle" class="form-control form-control-sm fw-bold border-0 p-0"
                       style="font-size:1rem;box-shadow:none;" placeholder="Task name" />
                <button type="button" class="btn-close ms-2" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" style="max-height:70vh;overflow-y:auto;">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea id="taskDetailDesc" class="form-control" rows="2"
                                  placeholder="Add a description..."></textarea>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-semibold mb-0">Progress</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="range" id="taskDetailProgress" min="0" max="100" step="5" class="form-range flex-grow-1" />
                                <span class="badge text-bg-primary" id="taskDetailProgressValue">0%</span>
                            </div>
                        </div>
                        <textarea id="taskDetailProgressNote" class="form-control mt-2" rows="2"
                                  placeholder="Add progress note..."></textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Progress Log</label>
                            <div id="taskDetailProgressLog" style="max-height:220px;overflow-y:auto;font-size:.8rem;">
                                <div class="text-muted">Loading...</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Activity Log</label>
                            <div id="taskDetailLog" style="max-height:220px;overflow-y:auto;font-size:.8rem;">
                                <div class="text-muted">Loading...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 px-3">
                <button type="button" class="btn btn-modal-action btn-sm" onclick="saveDetailModal()">
                    <i class="fas fa-save me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.task-log-entry {
    padding: .45rem .5rem;
    border-radius: .45rem;
    background: #f8f9fa;
    margin-bottom: .4rem;
}
.task-log-action {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #6c757d;
    margin-right: .25rem;
}
.task-log-desc {
    display: block;
    margin-top: .15rem;
    font-size: .8rem;
    color: #212529;
}
.task-log-meta {
    font-size: .72rem;
    color: #6c757d;
    margin-top: .2rem;
}
</style>

@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

// ─── Sort state ───────────────────────────────────────────────────
var activeSortField = null;
var activeSortDir   = null;

// ─── Filter Builder ───────────────────────────────────────────────
let filterRules = [];
let ruleSeq = 0;

const FIELD_CONFIG = {
    name:     { label: 'Name',     ops: ['contains','not_contains'] },
    priority: { label: 'Priority', ops: ['is','is_not'] },
    group:    { label: 'Group',    ops: ['is','is_not'] },
    year:     { label: 'Year',     ops: ['is','is_not','before','after'] },
    month:    { label: 'Month',    ops: ['is','is_not','before','after'] },
};
const OP_LABEL = { is:'is', is_not:'is not', contains:'contains', not_contains:'not contains', before:'before', after:'after' };

function valueOptions(field) {
    if (field === 'priority') return [['None','None'],['Low','Low'],['Medium','Medium'],['High','High']];
    if (field === 'group')    return GROUPS_DATA.map(g => [g.id, g.name]);
    if (field === 'year')     return YEARS_DATA.map(y => [y, y]);
    if (field === 'month')    return MONTHS_DATA.map(m => [m.key, m.label]);
    return null; // text input
}

function renderFilterRows() {
    const container = document.getElementById('filterRows');
    container.innerHTML = '';
    filterRules.forEach(rule => {
        const row = document.createElement('div');
        row.className = 'd-flex gap-2 align-items-center flex-wrap';
        row.dataset.ruleId = rule.id;

        // Field select
        const fSel = document.createElement('select');
        fSel.className = 'form-select form-select-sm';
        fSel.style.cssText = 'width:auto;min-width:110px;';
        Object.entries(FIELD_CONFIG).forEach(([k,v]) => {
            const o = document.createElement('option');
            o.value = k; o.textContent = v.label;
            if (k === rule.field) o.selected = true;
            fSel.appendChild(o);
        });
        fSel.addEventListener('change', () => { rule.field = fSel.value; rule.op = FIELD_CONFIG[fSel.value].ops[0]; rule.value = ''; renderFilterRows(); applyFilters(); });

        // Operator select
        const oSel = document.createElement('select');
        oSel.className = 'form-select form-select-sm';
        oSel.style.cssText = 'width:auto;min-width:110px;';
        FIELD_CONFIG[rule.field].ops.forEach(op => {
            const o = document.createElement('option');
            o.value = op; o.textContent = OP_LABEL[op];
            if (op === rule.op) o.selected = true;
            oSel.appendChild(o);
        });
        oSel.addEventListener('change', () => { rule.op = oSel.value; applyFilters(); });

        // Value input or select
        const opts = valueOptions(rule.field);
        let vEl;
        if (opts) {
            vEl = document.createElement('select');
            vEl.className = 'form-select form-select-sm';
            vEl.style.cssText = 'width:auto;min-width:130px;';
            const blank = document.createElement('option');
            blank.value = ''; blank.textContent = '— select —';
            vEl.appendChild(blank);
            opts.forEach(([val, lbl]) => {
                const o = document.createElement('option');
                o.value = val; o.textContent = lbl;
                if (val == rule.value) o.selected = true;
                vEl.appendChild(o);
            });
            vEl.addEventListener('change', () => { rule.value = vEl.value; applyFilters(); });
        } else {
            vEl = document.createElement('input');
            vEl.type = 'text';
            vEl.className = 'form-control form-control-sm';
            vEl.style.cssText = 'width:160px;';
            vEl.placeholder = 'type here…';
            vEl.value = rule.value || '';
            vEl.addEventListener('input', () => { rule.value = vEl.value; applyFilters(); });
        }

        // Remove button
        const rmBtn = document.createElement('button');
        rmBtn.type = 'button';
        rmBtn.className = 'btn btn-sm btn-outline-danger';
        rmBtn.style.cssText = 'font-size:.75rem;padding:2px 7px;';
        rmBtn.innerHTML = '&times;';
        rmBtn.addEventListener('click', () => { filterRules = filterRules.filter(r => r.id !== rule.id); renderFilterRows(); applyFilters(); });

        row.append(fSel, oSel, vEl, rmBtn);
        container.appendChild(row);
    });
}

function addFilterRow() {
    const field = 'priority';
    filterRules.push({ id: ++ruleSeq, field, op: FIELD_CONFIG[field].ops[0], value: '' });
    renderFilterRows();
}

function clearAllFilters() {
    filterRules = [];
    activeSortField = null;
    activeSortDir   = null;
    document.querySelectorAll('.sort-field-btn').forEach(b => {
        b.classList.remove('sort-active');
        b.querySelector('.sort-arrow').textContent = '↕';
    });
    document.getElementById('archiveSearch').value = '';
    renderFilterRows();
    applyFilters();
}

function matchRule(card, rule) {
    const { field, op, value } = rule;
    if (value === '' || value === null || value === undefined) return true;

    let cardVal;
    if (field === 'name')     cardVal = (card.dataset.search || '');
    if (field === 'priority') cardVal = card.dataset.priority || 'None';
    if (field === 'group')    cardVal = (card.dataset.group || '').split(',');
    if (field === 'year')     cardVal = card.dataset.year || '';
    if (field === 'month')    cardVal = card.dataset.month || '';

    if (op === 'is')           return Array.isArray(cardVal) ? cardVal.includes(String(value)) : cardVal === String(value);
    if (op === 'is_not')       return Array.isArray(cardVal) ? !cardVal.includes(String(value)) : cardVal !== String(value);
    if (op === 'contains')     return cardVal.includes(value.toLowerCase());
    if (op === 'not_contains') return !cardVal.includes(value.toLowerCase());
    if (op === 'before')       return cardVal < String(value);
    if (op === 'after')        return cardVal > String(value);
    return true;
}

function applyFilters() {
    const term = (document.getElementById('archiveSearch').value || '').toLowerCase();
    const grid = document.getElementById('archiveGrid');
    const cards = Array.from(document.querySelectorAll('#archiveGrid .kanban-card[data-search]'));

    // Sort DOM order first
    if (activeSortField && grid) {
        cards.sort((a, b) => {
            let av, bv;
            if (activeSortField === 'name') {
                av = (a.dataset.name || '').toLowerCase();
                bv = (b.dataset.name || '').toLowerCase();
            } else if (activeSortField === 'priority') {
                const order = { 'High': 0, 'Medium': 1, 'Low': 2, 'None': 3 };
                av = order[a.dataset.priority] ?? 3;
                bv = order[b.dataset.priority] ?? 3;
            } else if (activeSortField === 'date') {
                av = a.dataset.dueDate || '9999';
                bv = b.dataset.dueDate || '9999';
            } else if (activeSortField === 'progress') {
                av = Number(a.dataset.progress) || 0;
                bv = Number(b.dataset.progress) || 0;
            }
            if (av < bv) return activeSortDir === 'asc' ? -1 : 1;
            if (av > bv) return activeSortDir === 'asc' ? 1 : -1;
            return 0;
        });
        cards.forEach(c => grid.appendChild(c));
    }

    let visible = 0;
    cards.forEach(card => {
        const matchSearch = !term || card.dataset.search.includes(term);
        const matchRules  = filterRules.every(r => matchRule(card, r));
        const show = matchSearch && matchRules;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    const countEl = document.getElementById('filterCount');
    const hasFilter = term || filterRules.some(r => r.value !== '') || activeSortField;
    countEl.textContent = hasFilter ? `${visible} / ${cards.length} tasks` : '';
}

document.querySelectorAll('.sort-field-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        const field = this.dataset.field;
        const arrow = this.querySelector('.sort-arrow');
        if (activeSortField !== field) {
            // New field — reset others, start asc
            document.querySelectorAll('.sort-field-btn').forEach(b => {
                b.classList.remove('sort-active');
                b.querySelector('.sort-arrow').textContent = '↕';
            });
            activeSortField = field;
            activeSortDir = 'asc';
            this.classList.add('sort-active');
            arrow.textContent = '↑';
        } else if (activeSortDir === 'asc') {
            activeSortDir = 'desc';
            arrow.textContent = '↓';
        } else {
            // Reset
            activeSortField = null;
            activeSortDir = null;
            this.classList.remove('sort-active');
            arrow.textContent = '↕';
        }
        applyFilters();
    });
});

document.getElementById('archiveSearch').addEventListener('keyup', applyFilters);

let currentDetailId = null;
let currentDetailProgress = 0;

function syncProgressInputs(value) {
    const range = document.getElementById('taskDetailProgress');
    const badge = document.getElementById('taskDetailProgressValue');
    const parsed = Math.max(0, Math.min(100, Number(value) || 0));
    if (range) range.value = parsed;
    if (badge) badge.textContent = parsed + '%';
}

function renderLogEntries(entries, containerId, emptyText) {
    const container = document.getElementById(containerId);
    if (!container) return;
    if (!entries || entries.length === 0) {
        container.innerHTML = '<div class="text-muted small">' + emptyText + '</div>';
        return;
    }
    container.innerHTML = entries.map(l => {
        const detailText = l.description || '';
        const noteText = l.note || '';
        const mainText = detailText || noteText || '';
        return `
            <div class="task-log-entry">
                <span class="task-log-action">${l.actionType}</span>
                <span class="task-log-desc">${mainText}</span>
                ${noteText && detailText ? `<div class="text-muted small mt-1">${noteText}</div>` : ''}
                ${l.oldValue && l.newValue ? `<small class="text-muted ms-1">${l.oldValue} → ${l.newValue}</small>` : ''}
                <div class="task-log-meta">${l.userName} · ${l.createdAt}</div>
            </div>`;
    }).join('');
}

function openDetailModal(id, name, status) {
    currentDetailId = id;
    document.getElementById('taskDetailTitle').value = name;
    document.getElementById('taskDetailDesc').value = '';
    document.getElementById('taskDetailProgressNote').value = '';
    syncProgressInputs(0);
    document.getElementById('taskDetailProgressLog').innerHTML = '<div class="text-muted small">Loading...</div>';
    document.getElementById('taskDetailLog').innerHTML = '<div class="text-muted small">Loading...</div>';

    new bootstrap.Modal(document.getElementById('taskDetailModal')).show();

    fetch('/ProjectTracker/GetProjectDetails?id=' + id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(data => {
            if (data.name) document.getElementById('taskDetailTitle').value = data.name;
            document.getElementById('taskDetailDesc').value = data.description || '';
            currentDetailProgress = data.progress ?? 0;
            syncProgressInputs(currentDetailProgress);
            renderLogEntries(data.progressLogs || [], 'taskDetailProgressLog', 'No progress updates yet');
            renderLogEntries(data.logs || [], 'taskDetailLog', 'No activity yet');
        })
        .catch(() => {
            document.getElementById('taskDetailLog').innerHTML = '<div class="text-danger small">Failed to load</div>';
            document.getElementById('taskDetailProgressLog').innerHTML = '<div class="text-danger small">Failed to load</div>';
        });
}

async function saveDetailModal() {
    const name = document.getElementById('taskDetailTitle').value.trim();
    const desc = document.getElementById('taskDetailDesc').value;
    const progress = Number(document.getElementById('taskDetailProgress').value || 0);
    const note = document.getElementById('taskDetailProgressNote').value.trim();
    if (!name) return;

    const saveButton = document.querySelector('#taskDetailModal .btn-modal-action');
    if (saveButton) {
        saveButton.disabled = true;
        saveButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';
    }

    try {
        const r1 = await fetch('/ProjectTracker/UpdateName', {
            method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: new URLSearchParams({ id: currentDetailId, name, __RequestVerificationToken: token })
        });
        if (!r1.ok) throw new Error('UpdateName failed: ' + r1.status);

        const r2 = await fetch('/ProjectTracker/UpdateDescription', {
            method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: new URLSearchParams({ id: currentDetailId, description: desc, __RequestVerificationToken: token })
        });
        if (!r2.ok) throw new Error('UpdateDescription failed: ' + r2.status);

        if (note || progress !== currentDetailProgress) {
            const r3 = await fetch('/ProjectTracker/UpdateProgress', {
                method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams({ id: currentDetailId, progress, note, __RequestVerificationToken: token })
            });
            if (!r3.ok) throw new Error('UpdateProgress failed: ' + r3.status);
        }

        (bootstrap.Modal.getInstance(document.getElementById('taskDetailModal')) || new bootstrap.Modal(document.getElementById('taskDetailModal'))).hide();
    } catch (e) {
        console.error(e);
        alert('Unable to save changes. Please try again.');
    } finally {
        if (saveButton) {
            saveButton.disabled = false;
            saveButton.innerHTML = '<i class="fas fa-save me-1"></i>Save';
        }
    }
}

document.getElementById('taskDetailProgress').addEventListener('input', function () {
    syncProgressInputs(this.value);
});

document.querySelectorAll('.reopen-btn').forEach(btn => {
    btn.addEventListener('click', async function () {
        const id = this.getAttribute('data-project-id');
        try {
            const res = await fetch('/ProjectTracker/ReopenProject', {
                method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams({ id, __RequestVerificationToken: token })
            });
            if (res.ok) location.reload();
        } catch { }
    });
});
</script>
