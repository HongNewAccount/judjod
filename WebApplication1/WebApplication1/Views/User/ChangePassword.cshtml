@{
    ViewData["Title"] = "Change Password";
    var target = ViewBag.TargetUser as WebApplication1.Models.User;
    var currentUserId = Context.Session.GetInt32("UserId");
    var viewerRole = Context.Session.GetString("UserRole");
    var isSelf = currentUserId == target?.Id;
    var isAdmin = viewerRole == "Admin";
    var requireCurrentPassword = isSelf && !isAdmin;
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h6 class="fw-bold mb-1">Change Password</h6>
                    <p class="text-muted small mb-3">@target?.FirstName @target?.LastName</p>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger small py-2">@ViewBag.ErrorMessage</div>
                    }

                    <form method="post" asp-action="ChangePassword" asp-route-id="@target?.Id">
                        @Html.AntiForgeryToken()

                        @if (requireCurrentPassword)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Current Password <span class="text-danger">*</span></label>
                                <input type="password" name="currentPassword" class="form-control" placeholder="รหัสผ่านปัจจุบัน" required autocomplete="current-password" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">New Password <span class="text-danger">*</span></label>
                            <input type="password" name="newPassword" class="form-control" placeholder="รหัสผ่านใหม่" required autocomplete="new-password" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small">Confirm Password <span class="text-danger">*</span></label>
                            <input type="password" name="confirmPassword" class="form-control" placeholder="ยืนยันรหัสผ่านใหม่" required autocomplete="new-password" />
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@target?.Id" class="btn btn-secondary flex-fill">Cancel</a>
                            <button type="submit" class="btn btn-modal-action flex-fill">
                                <i class="fas fa-key me-1"></i>Change Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
