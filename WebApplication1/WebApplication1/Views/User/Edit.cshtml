@model WebApplication1.Models.User

@{
    ViewData["Title"] = "Edit Profile";
    var viewerRole = Context.Session.GetString("UserRole");
    var currentUserId = Context.Session.GetInt32("UserId");
    var isAdmin = viewerRole == "Admin";
    var isSelf = currentUserId == Model.Id;
    var requireCurrentPassword = isSelf && !isAdmin;
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12" style="max-width:860px;">

            <form method="post" asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">

                    @* Left: profile info *@
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">

                                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                                {
                                    <div class="alert alert-danger small py-2">
                                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <div>@err.ErrorMessage</div>
                                        }
                                    </div>
                                }

                                <div class="text-center mb-4">
                                    <div class="d-inline-block position-relative">
                                        @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                                        {
                                            <img id="avatarPreview" src="@Model.ProfileImagePath" alt="Profile"
                                                 class="rounded-circle"
                                                 style="width:90px;height:90px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div id="avatarPreview" class="rounded-circle d-inline-flex align-items-center justify-content-center text-white fw-bold"
                                                 style="width:90px;height:90px;font-size:32px;background:linear-gradient(135deg,#667eea,#764ba2);">
                                                @Model.FirstName[0]@(string.IsNullOrEmpty(Model.LastName) ? "" : Model.LastName[0].ToString())
                                            </div>
                                        }
                                        <label for="profileImage"
                                               class="position-absolute d-flex align-items-center justify-content-center rounded-circle"
                                               style="width:28px;height:28px;bottom:2px;right:2px;background:#fff;border:2px solid #dee2e6;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.15);"
                                               title="Change photo">
                                            <i class="fas fa-camera" style="font-size:.65rem;color:#495057;"></i>
                                        </label>
                                        <input type="file" id="profileImage" name="profileImage"
                                               accept="image/*" class="d-none"
                                               onchange="previewImage(this)" />
                                    </div>
                                    <div class="text-muted mt-1" style="font-size:.72rem;">JPG, PNG (Max 5MB)</div>
                                </div>

                                <hr class="mb-3" />

                                <div class="row g-3 mb-3">
                                    <div class="col-6">
                                        <label class="form-label fw-semibold small">ชื่อ <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" asp-for="FirstName" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fw-semibold small">นามสกุล</label>
                                        <input type="text" class="form-control" asp-for="LastName" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">วันเกิด</label>
                                    <input type="date" class="form-control" asp-for="BirthDate"
                                           value="@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">ที่อยู่</label>
                                    <input type="text" class="form-control" asp-for="WorkLocation" placeholder="บ้านเลขที่, ถนน, จังหวัด" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">เบอร์โทรศัพท์</label>
                                    <input type="tel" class="form-control" asp-for="Phone" placeholder="0812345678" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-semibold small">Gmail</label>
                                    <input type="email" class="form-control" asp-for="Email" placeholder="example@gmail.com" />
                                </div>

                            </div>
                        </div>
                    </div>

                    @* Right: change password *@
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4 d-flex flex-column">

                                <p class="fw-semibold mb-1">เปลี่ยนรหัสผ่าน</p>
                                <p class="text-muted small mb-1">ไม่บังคับ กรอกเฉพาะเมื่อต้องการเปลี่ยน</p>
                                @if (requireCurrentPassword)
                                {
                                    <p class="text-muted small mb-3">หากลืมรหัสผ่านปัจจุบันติดต่อ admin</p>
                                }
                                else
                                {
                                    <p class="mb-3"></p>
                                }

                                @if (ViewBag.PasswordError != null)
                                {
                                    <div class="alert alert-danger small py-2 mb-3">@ViewBag.PasswordError</div>
                                }

                                @if (requireCurrentPassword)
                                {
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small">รหัสผ่านปัจจุบัน</label>
                                        <input type="password" name="currentPassword" class="form-control"
                                               placeholder="รหัสผ่านปัจจุบัน" autocomplete="current-password" />
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">รหัสผ่านใหม่</label>
                                    <input type="password" name="newPassword" class="form-control"
                                           placeholder="รหัสผ่านใหม่" autocomplete="new-password" />
                                </div>

                                <div class="mb-auto">
                                    <label class="form-label fw-semibold small">ยืนยันรหัสผ่านใหม่</label>
                                    <input type="password" name="confirmPassword" class="form-control"
                                           placeholder="ยืนยันรหัสผ่านใหม่" autocomplete="new-password" />
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex gap-2 justify-content-end mt-3">
                    <button type="button" class="btn btn-secondary px-4" onclick="history.back()">Cancel</button>
                    <button type="submit" class="btn btn-modal-action px-4">
                        <i class="fas fa-save me-1"></i>Save
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<script>
function previewImage(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        const wrap = input.closest('.position-relative');
        const existing = wrap.querySelector('img#avatarPreview, div#avatarPreview');
        if (existing && existing.tagName === 'IMG') {
            existing.src = e.target.result;
        } else if (existing) {
            const img = document.createElement('img');
            img.id = 'avatarPreview';
            img.src = e.target.result;
            img.className = 'rounded-circle';
            img.style.cssText = 'width:90px;height:90px;object-fit:cover;';
            existing.replaceWith(img);
        }
    };
    reader.readAsDataURL(input.files[0]);
}
</script>
