@model IEnumerable<WebApplication1.Models.User>

@{
    ViewData["Title"] = "Users";
    var userRole = Context.Session.GetString("UserRole");
    var currentUserId = Context.Session.GetInt32("UserId");
    var pendingList = ViewBag.PendingUsers as List<WebApplication1.Models.User> ?? new List<WebApplication1.Models.User>();
    var pendingCount = pendingList.Count;
}

<div class="container-fluid">
    <div class="row mb-4 page-header">
        <div class="col d-flex gap-2 flex-wrap">
        @if (Context.Session.GetString("IsSuperAdmin") == "true")
        {
            <button type="button" class="btn btn-action" data-bs-toggle="modal" data-bs-target="#registerModal">
                <i class="fas fa-user-plus me-2"></i>Register User
            </button>
            <button type="button" class="btn btn-action position-relative" data-bs-toggle="modal" data-bs-target="#pendingModal"
                    style="@(pendingCount > 0 ? "background:var(--color-accent);" : "opacity:.75;")">
                <i class="fas fa-user-clock me-2"></i>Pending Approvals
                @if (pendingCount > 0)
                {
                    <span class="badge rounded-pill position-absolute top-0 start-100 translate-middle"
                          style="background:#ef4444;font-size:.6rem;">@pendingCount</span>
                }
            </button>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row g-2">
            @foreach (var user in Model)
            {
                <div class="col-12 col-md-4">
                    <a asp-action="Details" asp-route-id="@user.Id"
                       class="user-row card border-0 shadow-sm text-decoration-none text-reset d-flex flex-row align-items-center gap-3 p-3">

                        @if (!string.IsNullOrEmpty(user.ProfileImagePath))
                        {
                            <img src="@user.ProfileImagePath" alt="@user.FirstName" class="user-row-avatar" style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="user-row-avatar d-flex align-items-center justify-content-center">
                                @user.FirstName[0]@(string.IsNullOrEmpty(user.LastName) ? "" : user.LastName[0].ToString())
                            </div>
                        }

                        <div class="flex-grow-1" style="min-width:0;">
                            <div class="fw-semibold text-truncate">@user.FirstName @user.LastName</div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @if (user.Id == 1)
                                {
                                    <span class="badge bg-danger" style="font-size:.68rem;">Admin</span>
                                }
                                else
                                {
                                    @if (user.Role == "Editor")
                                    {
                                        <span class="badge bg-primary" style="font-size:.68rem;">Editor</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="font-size:.68rem;">User</span>
                                    }
                                }
                                @if (!user.IsActive)
                                {
                                    <span class="badge bg-danger" style="font-size:.68rem;"><i class="fas fa-ban me-1"></i>Banned</span>
                                }
                                @if (user.ProjectAccessSuspended)
                                {
                                    <span class="badge bg-warning text-dark" style="font-size:.68rem;">Suspended</span>
                                }
                            </div>
                        </div>

                        <i class="fas fa-chevron-right text-muted flex-shrink-0" style="font-size:.75rem;"></i>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No users found.</div>
    }
</div>

<!-- ═══ Register Modal ═══ -->
@if (Context.Session.GetString("IsSuperAdmin") == "true")
{
    <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header py-3 px-4" style="background:var(--color-accent);color:#1a1a2e;">
                    <h6 class="modal-title fw-bold">
                        <i class="fas fa-user-plus me-2"></i>Register User
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="regError" class="alert alert-danger small py-2 d-none"></div>
                    <form id="regForm" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input type="text" name="username" class="form-control" placeholder="Enter username" autocomplete="username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="form-control" placeholder="Enter password" autocomplete="new-password" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                            <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" />
                        </div>
                        <div class="mb-4 p-3 bg-light rounded">
                            <label class="form-label fw-semibold mb-2 d-block">Initial Settings</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="regChat" checked />
                                    </div>
                                    <label for="regChat" class="small fw-semibold mb-0">
                                        <i class="fas fa-comments me-1" style="color:#3b82f6;"></i>Chat Access
                                    </label>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="regProject" checked />
                                    </div>
                                    <label for="regProject" class="small fw-semibold mb-0">
                                        <i class="fas fa-columns me-1 text-primary"></i>Project Access
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <button type="submit" class="btn btn-modal-action px-5">
                                <i class="fas fa-user-check me-1"></i>Create User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ═══ Pending Approvals Modal ═══ -->
@if (Context.Session.GetString("IsSuperAdmin") == "true")
{
    <div class="modal fade" id="pendingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header py-3 px-4" style="background:var(--color-accent);color:#1a1a2e;">
                    <h6 class="modal-title fw-bold">
                        <i class="fas fa-user-clock me-2"></i>Pending Approvals
                        @if (pendingList.Count > 0)
                        {
                            <span class="badge rounded-pill ms-2" style="background:#ef4444;font-size:.65rem;">@pendingList.Count</span>
                        }
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    @if (!pendingList.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-check-circle fa-2x mb-2 d-block" style="color:#22c55e;"></i>
                            ไม่มีคำขอสมัครสมาชิกที่รออนุมัติ
                        </div>
                    }
                    else
                    {
                        <div id="pendingList">
                            @foreach (var u in pendingList)
                            {
                                <div class="pending-row d-flex align-items-center gap-3 px-4 py-3 border-bottom" data-uid="@u.Id">
                                    <div class="user-row-avatar d-flex align-items-center justify-content-center flex-shrink-0">
                                        @u.FirstName[0]@(string.IsNullOrEmpty(u.LastName) ? "" : u.LastName[0].ToString())
                                    </div>
                                    <div class="flex-grow-1" style="min-width:0;">
                                        <div class="fw-semibold">@u.FirstName @u.LastName</div>
                                        <div class="text-muted small">@@<span>@u.Username</span></div>
                                        <div class="text-muted" style="font-size:.72rem;">
                                            <i class="fas fa-clock me-1"></i>@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 flex-shrink-0">
                                        <form method="post" asp-action="ApproveRegistration" asp-route-id="@u.Id" class="approve-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success px-3" title="อนุมัติ">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="RejectRegistration" asp-route-id="@u.Id" class="reject-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger px-3" title="ปฏิเสธ">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
.user-row-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    font-size: 14px;
    font-weight: bold;
    flex-shrink: 0;
}
.user-row {
    transition: box-shadow 0.15s ease;
    cursor: pointer;
}
.user-row:hover {
    box-shadow: 0 4px 12px rgba(0,0,0,.1) !important;
}
</style>

@section Scripts {
<script>
// Approve / Reject via AJAX so modal stays open and row animates out
(function () {
    document.querySelectorAll('.approve-form, .reject-form').forEach(function (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var isApprove = form.classList.contains('approve-form');
            var row = form.closest('.pending-row');
            if (!isApprove && !confirm('ปฏิเสธการลงทะเบียนนี้?')) return;

            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            var res = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            });

            if (res.ok) {
                row.style.transition = 'opacity .3s';
                row.style.opacity = '0';
                setTimeout(function () {
                    row.remove();
                    // update badge counts
                    var remaining = document.querySelectorAll('.pending-row').length;
                    document.querySelectorAll('[data-bs-target="#pendingModal"] .badge, .modal-title .badge').forEach(function (b) {
                        if (remaining > 0) b.textContent = remaining;
                        else b.remove();
                    });
                    if (remaining === 0) {
                        var list = document.getElementById('pendingList');
                        if (list) list.innerHTML = '<div class="text-center py-5 text-muted"><i class="fas fa-check-circle fa-2x mb-2 d-block" style="color:#22c55e;"></i>ไม่มีคำขอสมัครสมาชิกที่รออนุมัติ</div>';
                    }
                    if (isApprove) location.reload(); // refresh user list to show new member
                }, 300);
            }
        });
    });
})();

(function () {
    var form = document.getElementById('regForm');
    if (!form) return;

    var modal = document.getElementById('registerModal');
    modal.addEventListener('hidden.bs.modal', function () {
        form.reset();
        document.getElementById('regError').classList.add('d-none');
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var errEl = document.getElementById('regError');
        errEl.classList.add('d-none');

        var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        var params = new URLSearchParams({
            __RequestVerificationToken: token,
            username:        form.querySelector('[name="username"]').value,
            password:        form.querySelector('[name="password"]').value,
            confirmPassword: form.querySelector('[name="confirmPassword"]').value,
            chatEnabled:     document.getElementById('regChat').checked,
            projectAccess:   document.getElementById('regProject').checked,
        });

        var res = await fetch('/Auth/Register', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params
        });
        var json = await res.json();
        if (json.success) {
            location.reload();
        } else {
            errEl.textContent = json.error;
            errEl.classList.remove('d-none');
        }
    });
})();
</script>
}
