@model IList<WebApplication1.Models.StickyNote>
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Notes";
    var currentUserId = Context.Session.GetInt32("UserId");
    var userRole      = Context.Session.GetString("UserRole");
    var isAdmin       = userRole == "Admin";
    var isEditor      = userRole == "Editor";
    var canManage     = isAdmin || isEditor;

    var palette = new (string hex, string name)[]
    {
        ("#fef08a", "เหลือง"),
        ("#fecdd3", "ชมพู"),
        ("#bbf7d0", "เขียว"),
        ("#bae6fd", "ฟ้า"),
        ("#e9d5ff", "ม่วง"),
        ("#fed7aa", "ส้ม"),
        ("#f1f5f9", "ขาว"),
    };
}

<div class="container-fluid">

    @* ── Header ── *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <button class="btn btn-action btn-sm" id="addNoteBtn" onclick="startNewNote()">
            <i class="fas fa-plus me-1"></i>เพิ่มโน้ต
        </button>
        <small class="text-muted"><span id="noteCount">@Model.Count</span> โน้ต · หมดอายุใน 30 วัน</small>
    </div>

    @* ── Board ── *@
    <div class="notes-board">
        @if (!Model.Any())
        {
            <div class="empty-state" id="emptyState">
                <i class="fas fa-sticky-note" style="font-size:3.5rem;color:rgba(0,0,0,.1);"></i>
                <p class="mt-3 mb-0" style="color:rgba(0,0,0,.35);font-size:.95rem;">ยังไม่มีโน้ต — เป็นคนแรกที่เพิ่มโน้ต!</p>
            </div>
        }
        <div class="notes-grid" id="notesGrid">
            @foreach (var note in Model)
            {
                var daysLeft = Math.Max(0, (int)(note.ExpiresAt.Date - DateTime.UtcNow.Date).TotalDays);
                var urgency  = daysLeft < 3 ? "urgent" : daysLeft < 7 ? "warn" : "";
                var canDel   = note.UserId == currentUserId || canManage;
                var canEdit  = note.UserId == currentUserId || isAdmin;
                <div class="sticky-note" data-color="@note.Color" style="background:@note.Color;">
                    @if (canDel)
                    {
                        <button class="note-delete" onclick="deleteNote(@note.Id, this)" title="ลบ">
                            <i class="fas fa-times"></i>
                        </button>
                    }
                    @if (canEdit)
                    {
                        <button class="note-edit" onclick="startEditNote(@note.Id, this)" title="แก้ไข">
                            <i class="fas fa-pen"></i>
                        </button>
                    }
                    <div class="note-pin"></div>
                    @if (!string.IsNullOrEmpty(note.Title))
                    {
                        <h6 class="note-title">@note.Title</h6>
                    }
                    <p class="note-content">@note.Content</p>
                    <div class="note-footer">
                        <div class="note-author">
                            <div class="note-avatar">@note.User!.FirstName[0]</div>
                            <span class="note-author-name">@note.User.FirstName</span>
                        </div>
                        <span class="note-expiry @urgency">
                            @if (daysLeft == 0) { <text>หมดวันนี้</text> }
                            else { <text>@daysLeft วัน</text> }
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
/* ── Board ── */
.notes-board {
    background: #fff;
    border-radius: 16px;
    padding: 2.5rem 2rem 1.5rem;
    min-height: 380px;
}
.empty-state { text-align:center; padding:4rem 0; }

/* ── Grid ── */
.notes-grid {
    columns: 4 220px;
    column-gap: 1.5rem;
}

/* ── Note card ── */
.sticky-note {
    position: relative;
    border-radius: 4px;
    padding: 1.75rem 1.25rem 1rem;
    box-shadow: 3px 5px 14px rgba(0,0,0,.13), 0 1px 3px rgba(0,0,0,.08);
    break-inside: avoid;
    margin-bottom: 1.5rem;
    display: inline-block;
    width: 100%;
    transition: transform .22s ease, box-shadow .22s ease;
    will-change: transform;
}
.sticky-note:not(.editing-card):nth-child(4n+1) { transform: rotate(-1.4deg); }
.sticky-note:not(.editing-card):nth-child(4n+2) { transform: rotate(1.1deg); }
.sticky-note:not(.editing-card):nth-child(4n+3) { transform: rotate(-0.6deg); }
.sticky-note:not(.editing-card):nth-child(4n+4) { transform: rotate(1.8deg); }
.sticky-note:not(.editing-card):hover {
    transform: rotate(0deg) translateY(-5px) scale(1.01) !important;
    box-shadow: 5px 10px 24px rgba(0,0,0,.18), 0 2px 5px rgba(0,0,0,.1);
    z-index: 10;
}

/* ── Editing card ── */
.editing-card {
    transform: none !important;
    box-shadow: 0 0 0 2.5px #1a1a2e, 4px 8px 20px rgba(0,0,0,.18) !important;
    z-index: 20;
}
.note-edit-ui {
    display: flex;
    flex-direction: column;
}

/* ── Color bar inside editing card ── */
.edit-color-bar {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-bottom: 1rem;
}
.edit-swatch {
    width: 20px; height: 20px;
    border-radius: 50%;
    cursor: pointer;
    border: 2.5px solid transparent;
    box-shadow: 0 1px 4px rgba(0,0,0,.2);
    transition: transform .12s, border-color .12s;
    flex-shrink: 0;
}
.edit-swatch:hover  { transform: scale(1.2); }
.edit-swatch.active { border-color: #1a1a2e; transform: scale(1.2); }

/* ── Contenteditable fields ── */
.edit-title, .edit-content {
    outline: none;
    width: 100%;
    word-break: break-word;
    white-space: pre-wrap;
}
.edit-title {
    font-weight: 700;
    font-size: .95rem;
    color: rgba(0,0,0,.72);
    line-height: 1.3;
    margin-bottom: .45rem;
    min-height: 1.3em;
}
.edit-content {
    font-size: .86rem;
    color: rgba(0,0,0,.62);
    line-height: 1.65;
    margin-bottom: .75rem;
    min-height: 4em;
}
.edit-title:empty::before {
    content: attr(data-placeholder);
    color: rgba(0,0,0,.3);
    font-weight: 400;
    pointer-events: none;
}
.edit-content:empty::before {
    content: attr(data-placeholder);
    color: rgba(0,0,0,.28);
    pointer-events: none;
}

/* ── Edit action buttons (inside card) ── */
.edit-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .5rem;
    border-top: 1px solid rgba(0,0,0,.09);
    padding-top: .6rem;
    margin-top: .2rem;
}
.edit-cancel-btn {
    background: none;
    border: 1px solid rgba(0,0,0,.2);
    border-radius: 50px;
    padding: .28rem .85rem;
    font-size: .78rem;
    font-weight: 600;
    color: rgba(0,0,0,.55);
    cursor: pointer;
    transition: background .12s;
}
.edit-cancel-btn:hover { background: rgba(0,0,0,.06); }
.edit-save-btn {
    background: #1a1a2e;
    color: #f7ef05;
    border: none;
    border-radius: 50px;
    padding: .28rem .95rem;
    font-size: .78rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: .35rem;
    transition: opacity .12s, transform .12s;
}
.edit-save-btn:hover   { opacity: .85; transform: translateY(-1px); }
.edit-save-btn:disabled { opacity: .5; }

/* ── Char counter ── */
.edit-char {
    font-size: .68rem;
    color: rgba(0,0,0,.35);
    text-align: right;
    margin-top: -4px;
    margin-bottom: 6px;
}

/* ── Pin ── */
.note-pin {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    width: 18px; height: 18px;
    background: radial-gradient(circle at 35% 30%, #ff8080, #c0392b);
    border-radius: 50%;
    box-shadow: 0 3px 7px rgba(0,0,0,.3), inset 0 1px 2px rgba(255,255,255,.35);
}
.note-pin::after {
    content: '';
    position: absolute;
    top: 28%; left: 28%;
    width: 6px; height: 6px;
    background: rgba(255,255,255,.45);
    border-radius: 50%;
}

/* ── Edit button ── */
.note-edit {
    position: absolute;
    top: 8px; left: 8px;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: rgba(0,0,0,.1);
    border: none;
    color: rgba(0,0,0,.45);
    font-size: .6rem;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity .15s, background .15s, color .15s;
}
.sticky-note:hover .note-edit { opacity: 1; }
.note-edit:hover { background: #1a1a2e; color: #f7ef05; }

/* ── Delete button ── */
.note-delete {
    position: absolute;
    top: 8px; right: 8px;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: rgba(0,0,0,.1);
    border: none;
    color: rgba(0,0,0,.45);
    font-size: .6rem;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity .15s, background .15s, color .15s;
}
.sticky-note:hover .note-delete { opacity: 1; }
.note-delete:hover { background: #ef4444; color: #fff; }

/* ── Text ── */
.note-title {
    font-weight: 700;
    font-size: .95rem;
    margin-bottom: .45rem;
    color: rgba(0,0,0,.72);
    line-height: 1.3;
    word-break: break-word;
}
.note-content {
    font-size: .86rem;
    color: rgba(0,0,0,.62);
    line-height: 1.65;
    word-break: break-word;
    white-space: pre-wrap;
    margin-bottom: .75rem;
    min-height: 1.5rem;
}

/* ── Footer ── */
.note-footer {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid rgba(0,0,0,.09);
    padding-top: .55rem;
}
.note-author { display:flex; align-items:center; gap:.4rem; }
.note-avatar {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: rgba(0,0,0,.18);
    color: rgba(0,0,0,.55);
    font-size: .68rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
}
.note-author-name { font-size: .73rem; color: rgba(0,0,0,.5); font-weight: 500; }
.note-expiry      { font-size: .7rem; color: rgba(0,0,0,.38); }
.note-expiry.warn   { color: #d97706; font-weight: 600; }
.note-expiry.urgent { color: #dc2626; font-weight: 700; }

/* ── Error toast inside board ── */
#boardError {
    position: fixed;
    bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    background: #dc2626; color: #fff;
    padding: .55rem 1.25rem;
    border-radius: 50px;
    font-size: .84rem; font-weight: 600;
    box-shadow: 0 4px 16px rgba(220,38,38,.35);
    z-index: 9999;
    display: none;
}
</style>

<div id="boardError"></div>

@section Scripts {
<script>
var editColor  = '#fef08a';
var isEditing  = false;

var PALETTE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(palette.Select(p => p.hex).ToArray()));

function getToken() {
    var el = document.querySelector('[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}

/* ── Show inline editing card ── */
function startNewNote() {
    if (isEditing) {
        document.getElementById('editCard')?.querySelector('.edit-title')?.focus();
        return;
    }
    isEditing = true;
    editColor = '#fef08a';

    var swatches = PALETTE.map(function(hex, i) {
        return '<div class="edit-swatch' + (i === 0 ? ' active' : '') + '" data-color="' + hex + '" style="background:' + hex + ';"></div>';
    }).join('');

    var card = document.createElement('div');
    card.className = 'sticky-note editing-card';
    card.id = 'editCard';
    card.style.background = editColor;
    card.innerHTML =
        '<div class="note-pin"></div>' +
        '<div class="edit-color-bar" id="editColorBar">' + swatches + '</div>' +
        '<div class="edit-title" id="editTitle" contenteditable="true" data-placeholder="หัวข้อ (ไม่บังคับ)" maxlength="100"></div>' +
        '<div class="edit-content" id="editContent" contenteditable="true" data-placeholder="เขียนอะไรก็ได้..."></div>' +
        '<div class="edit-char"><span id="editCharCount">0</span>/500</div>' +
        '<div class="edit-actions">' +
            '<button class="edit-cancel-btn" onclick="cancelNewNote()">ยกเลิก</button>' +
            '<button class="edit-save-btn" id="editSaveBtn" onclick="saveNewNote()">' +
                '<i class="fas fa-thumbtack"></i> ปักหมุด' +
            '</button>' +
        '</div>';

    var grid = getOrCreateGrid();
    grid.prepend(card);

    /* hide empty state */
    var empty = document.getElementById('emptyState');
    if (empty) empty.style.display = 'none';

    /* color picker */
    card.querySelector('#editColorBar').addEventListener('click', function(e) {
        var sw = e.target.closest('.edit-swatch');
        if (!sw) return;
        card.querySelectorAll('.edit-swatch').forEach(function(s) { s.classList.remove('active'); });
        sw.classList.add('active');
        editColor = sw.dataset.color;
        card.style.background = editColor;
    });

    /* char counter */
    var contentEl = card.querySelector('#editContent');
    contentEl.addEventListener('input', function() {
        var len = this.innerText.replace(/\n$/, '').length;
        if (len > 500) {
            var sel = window.getSelection();
            this.innerText = this.innerText.substring(0, 500);
            /* restore caret to end */
            var range = document.createRange();
            range.selectNodeContents(this);
            range.collapse(false);
            sel.removeAllRanges();
            sel.addRange(range);
        }
        card.querySelector('#editCharCount').textContent = Math.min(len, 500);
    });

    /* title: block enter */
    card.querySelector('#editTitle').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); contentEl.focus(); }
    });

    /* Ctrl+Enter saves */
    card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) saveNewNote();
        if (e.key === 'Escape') cancelNewNote();
    });

    setTimeout(function() { card.querySelector('#editTitle').focus(); }, 50);
}

function cancelNewNote() {
    var card = document.getElementById('editCard');
    if (card) {
        card.style.transition = 'opacity .18s, transform .18s';
        card.style.opacity = '0';
        card.style.transform = 'scale(.9)';
        setTimeout(function() {
            card.remove();
            isEditing = false;
            /* show empty state if no notes */
            var grid = document.getElementById('notesGrid');
            if (grid && grid.children.length === 0) {
                var empty = document.getElementById('emptyState');
                if (empty) empty.style.display = '';
            }
        }, 180);
    } else {
        isEditing = false;
    }
}

async function saveNewNote() {
    var titleEl   = document.getElementById('editTitle');
    var contentEl = document.getElementById('editContent');
    var saveBtn   = document.getElementById('editSaveBtn');

    var title   = (titleEl   ? titleEl.innerText.trim()   : '');
    var content = (contentEl ? contentEl.innerText.trim() : '');

    if (!content) {
        showBoardError('กรุณากรอกข้อความ');
        if (contentEl) contentEl.focus();
        return;
    }

    if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }

    try {
        var body = 'title='   + encodeURIComponent(title)
                 + '&content=' + encodeURIComponent(content)
                 + '&color='   + encodeURIComponent(editColor)
                 + '&__RequestVerificationToken=' + encodeURIComponent(getToken());

        var res = await fetch('/StickyNote/Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: body
        });

        if (!res.ok) { var t = await res.text(); throw new Error('HTTP ' + res.status); }
        var data = await res.json();
        if (!data.success) throw new Error(data.error || 'เกิดข้อผิดพลาด');

        /* replace editing card with real note */
        var card = document.getElementById('editCard');
        if (card) {
            var newNote = buildNoteEl(data);
            card.replaceWith(newNote);
            requestAnimationFrame(function() {
                requestAnimationFrame(function() {
                    newNote.style.opacity    = '1';
                    newNote.style.transform  = 'rotate(-1deg)';
                });
            });
        }
        isEditing = false;
        updateCount(1);

    } catch(e) {
        showBoardError('Error: ' + e.message);
        if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="fas fa-thumbtack"></i> ปักหมุด'; }
        console.error(e);
    }
}

/* ── Build real note DOM element ── */
function buildNoteEl(n) {
    var div = document.createElement('div');
    div.className = 'sticky-note';
    div.dataset.color = n.color;
    div.style.cssText = 'background:' + n.color + ';opacity:0;transform:scale(.88);transition:opacity .28s ease,transform .28s ease;';
    div.innerHTML =
        '<button class="note-delete" onclick="deleteNote(' + n.id + ',this)" title="ลบ"><i class="fas fa-times"></i></button>' +
        '<button class="note-edit"   onclick="startEditNote(' + n.id + ',this)" title="แก้ไข"><i class="fas fa-pen"></i></button>' +
        '<div class="note-pin"></div>' +
        (n.title ? '<h6 class="note-title">' + esc(n.title) + '</h6>' : '') +
        '<p class="note-content">' + esc(n.content) + '</p>' +
        '<div class="note-footer"><div class="note-author"><div class="note-avatar">' + esc(n.authorInitial) + '</div>' +
        '<span class="note-author-name">' + esc(n.authorName) + '</span></div>' +
        '<span class="note-expiry">' + n.daysLeft + ' วัน</span></div>';
    return div;
}

/* ── Update counter ── */
function updateCount(delta) {
    var el = document.getElementById('noteCount');
    if (!el) return;
    el.textContent = Math.max(0, (parseInt(el.textContent, 10) || 0) + delta);
}

/* ── Delete ── */
async function deleteNote(id, btn) {
    var note = btn.closest('.sticky-note');
    try {
        var res = await fetch('/StickyNote/Delete/' + id, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(getToken())
        });
        if (res.ok) {
            note.style.transition = 'opacity .2s, transform .2s';
            note.style.opacity    = '0';
            note.style.transform  = 'scale(.8)';
            updateCount(-1);
            setTimeout(function() {
                if (note.parentNode) note.remove();
                var grid = document.getElementById('notesGrid');
                if (grid && grid.children.length === 0) {
                    var empty = document.getElementById('emptyState');
                    if (empty) empty.style.display = '';
                }
            }, 220);
        }
    } catch(e) { console.error(e); }
}

/* ── Edit existing note (hide/show — never replaces innerHTML) ── */
function startEditNote(id, btn) {
    var card = btn.closest('.sticky-note');
    if (card.classList.contains('editing-card')) return;

    var origColor  = card.dataset.color;
    var titleEl    = card.querySelector('.note-title');
    var contentEl  = card.querySelector('.note-content');
    var origTitle   = titleEl   ? titleEl.textContent.trim()   : '';
    var origContent = contentEl ? contentEl.textContent.trim() : '';
    var editingColor = origColor;

    /* hide all existing children, keep references */
    var hiddenKids = Array.from(card.children);
    hiddenKids.forEach(function(c) { c.style.display = 'none'; });
    card.classList.add('editing-card');

    /* build edit UI as a separate element */
    var ui = document.createElement('div');
    ui.className = 'note-edit-ui';

    var swatches = PALETTE.map(function(hex) {
        return '<div class="edit-swatch' + (hex === origColor ? ' active' : '') + '" data-color="' + hex + '" style="background:' + hex + ';"></div>';
    }).join('');

    ui.innerHTML =
        '<div class="edit-color-bar">' + swatches + '</div>' +
        '<div class="edit-title" contenteditable="true" data-placeholder="หัวข้อ (ไม่บังคับ)"></div>' +
        '<div class="edit-content" contenteditable="true" data-placeholder="เขียนอะไรก็ได้..."></div>' +
        '<div class="edit-char"><span class="ecc">0</span>/500</div>' +
        '<div class="edit-actions">' +
            '<button class="edit-cancel-btn">ยกเลิก</button>' +
            '<button class="edit-save-btn"><i class="fas fa-check"></i> บันทึก</button>' +
        '</div>';

    card.appendChild(ui);

    var uiTitle   = ui.querySelector('.edit-title');
    var uiContent = ui.querySelector('.edit-content');
    var charSpan  = ui.querySelector('.ecc');
    var saveBtn   = ui.querySelector('.edit-save-btn');

    uiTitle.textContent   = origTitle;
    uiContent.textContent = origContent;
    charSpan.textContent  = origContent.length;

    /* color picker */
    ui.querySelector('.edit-color-bar').addEventListener('click', function(e) {
        var sw = e.target.closest('.edit-swatch');
        if (!sw) return;
        ui.querySelectorAll('.edit-swatch').forEach(function(s) { s.classList.remove('active'); });
        sw.classList.add('active');
        editingColor = sw.dataset.color;
        card.style.background = editingColor;
    });

    /* char counter */
    uiContent.addEventListener('input', function() {
        var len = this.innerText.replace(/\n$/, '').length;
        if (len > 500) {
            this.innerText = this.innerText.substring(0, 500);
            var r = document.createRange(); r.selectNodeContents(this); r.collapse(false);
            var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
        }
        charSpan.textContent = Math.min(len, 500);
    });

    /* Enter in title → jump to content */
    uiTitle.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); uiContent.focus(); }
    });

    function handleKey(e) {
        if (e.key === 'Escape')                          doCancel();
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) doSave();
    }
    card.addEventListener('keydown', handleKey);

    function doCancel() {
        ui.remove();
        card.removeEventListener('keydown', handleKey);
        card.classList.remove('editing-card');
        card.style.background = origColor;
        hiddenKids.forEach(function(c) { c.style.display = ''; });
    }

    async function doSave() {
        var t = uiTitle.innerText.trim();
        var c = uiContent.innerText.trim();
        if (!c) { showBoardError('กรุณากรอกข้อความ'); uiContent.focus(); return; }

        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
            var body = 'id=' + id
                     + '&title='   + encodeURIComponent(t)
                     + '&content=' + encodeURIComponent(c)
                     + '&color='   + encodeURIComponent(editingColor)
                     + '&__RequestVerificationToken=' + encodeURIComponent(getToken());

            var res = await fetch('/StickyNote/Edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: body
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var data = await res.json();
            if (!data.success) throw new Error(data.error || 'เกิดข้อผิดพลาด');

            /* update title element in-place (no innerHTML replace) */
            var nt = card.querySelector('.note-title');
            if (data.title) {
                if (!nt) {
                    nt = document.createElement('h6');
                    nt.className = 'note-title';
                    var pin = card.querySelector('.note-pin');
                    if (pin) pin.insertAdjacentElement('afterend', nt);
                    else card.prepend(nt);
                }
                nt.textContent = data.title;
            } else {
                if (nt) nt.remove();
            }
            var nc = card.querySelector('.note-content');
            if (nc) nc.textContent = data.content;

            /* update color */
            card.style.background = data.color;
            card.dataset.color = data.color;

            /* remove edit UI, show original children */
            ui.remove();
            card.removeEventListener('keydown', handleKey);
            card.classList.remove('editing-card');
            hiddenKids.forEach(function(c) { c.style.display = ''; });

        } catch(e) {
            showBoardError('Error: ' + e.message);
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-check"></i> บันทึก';
            console.error(e);
        }
    }

    ui.querySelector('.edit-cancel-btn').addEventListener('click', doCancel);
    saveBtn.addEventListener('click', doSave);

    uiContent.focus();
    var r = document.createRange(); r.selectNodeContents(uiContent); r.collapse(false);
    var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
}

/* ── Helpers ── */
function getOrCreateGrid() {
    var grid = document.getElementById('notesGrid');
    if (!grid) {
        grid = document.createElement('div');
        grid.className = 'notes-grid';
        grid.id = 'notesGrid';
        document.querySelector('.notes-board').appendChild(grid);
    }
    return grid;
}

function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

var _errTimer;
function showBoardError(msg) {
    var el = document.getElementById('boardError');
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    clearTimeout(_errTimer);
    _errTimer = setTimeout(function() { el.style.display = 'none'; }, 3500);
}

</script>
}
